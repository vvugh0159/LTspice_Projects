TEXT -2016 640 Left 2 ;.tran 0 10 0 startup
TEXT -2000 936 Left 2 !.model SW SW(Ron=10m, Roff=10Meg, Vt=2.5, Vh=-0.1)
TEXT -2008 968 Left 2 !.param Fs=200.0E3\n.param Ts = 1.0/Fs\n.param D = 0.15\n.param Rsns = 0.2\n.param RL = 1k
TEXT -2008 584 Left 2 !.model Dideal D(Ron=10m Roff=10Meg Vfwd=1m Vrev=200)
TEXT -2008 696 Left 2 !.param Lm = 10u\n.param Lp = 10\n.param Nturns_pri = 8\n.param Nturns_sec = 12\n.param Ns_div_Np = {Nturns_sec/Nturns_pri}\n.param Ls = ({Ns_div_Np}*{Ns_div_Np}*{Lp})\n.param n = {Ns_div_Np}
TEXT -2000 1136 Left 2 !.savebias bias.txt time=2
TEXT -2000 1168 Left 2 !.loadbias bias.txt
TEXT -2000 1200 Left 2 !.ac dec 1k 1 10Meg
TEXT -208 2696 Left 3 ;Step 0. Ensure all voltage references and bias voltages are correct.\n \nStep 1. Reflect/Reference diode on control output winding to primary side. Leave other diodes remaining to emulate loss.\n \nStep 2. Set turns ratio parameter of averaged switch/diode circuit to 1\n \nStep 3. Configure peak-current sense block correctly.\nVL_P = Most positive voltage of magnetizing inductor when switch is ON (+VIN for this flyback)\nVL_N = Most negative voltage of magnetizing inductor when switch is ON (GND for this flyback)\nV_ILAvg = Averaged magnetizing inductor current when switch is ON, which is equal to the average switch current\n \nStep 4. Use high-gain voltage amp to drive feedback such that EA_OUT = Scaled peak current sense,\nwhich equates to peak current mode control.\n \nStep 5. Wire external compensator/feedback.
TEXT 120 -264 Left 2 !.param L_AB = 9.53u\n.param L_21 = 22.0u\n.param L_43 = 22.3u\n.param L_56 = 22.3u\n.param L_78 = 2.50u\n.param L_9_10 = 9.03u
TEXT 120 -8 Left 2 !.param RDC_AB 32.5m\n.param RDC_21 = 80m\n.param RDC_43 = 70m\n.param RDC_56 = 90m\n.param RDC_78 = 8m\n.param RDC_9_10 = 20m
TEXT 128 184 Left 2 !.param RCNVG 1G
TEXT 488 -16 Left 2 !.param LLKG_AB = 500n\n.param LLKG_21 = 500n\n.param LLKG_43 = 1.75u\n.param LLKG_56 = 250n\n.param LLKG_78 = 175n\n.param LLKG_9_10 =125n
TEXT 488 -264 Left 2 !.param Cp_AB = 30p\n.param Cp_21 = 30p\n.param Cp_43 = 30p\n.param Cp_56 = 30p\n.param Cp_78 = 30p\n.param Cp_9_10 = 30p
TEXT 128 224 Left 2 !.param RTERM1 10G\n.param RTERM2 10n
TEXT 4264 2392 Right 7 ;Load Step
TEXT -2016 216 Left 2 !.options\n+ Gmin = 1e-10\n+ Abstol = 1e-10\n+ Reltol = 0.0001\n+ Chgtol = 1e-11\n+ Trtol = 2\n+ vntol = 0.00001\n+ Sstol = 0.001\n+ MinDeltaGmin = 0.0001\n+ Method = Gear
TEXT -2000 1248 Left 2 !.param L_ESL_COUT = 50n\n.param R_ESR_COUT = 20m
